; Engine configuration file.
; Built for the Godot 3.x API (tested against 3.4.5; should open in compatible 3.4 builds).
config_version=4

[application]
config/name="THE HUM: Archive of the Drowned"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/width=1600
window/size/height=900
window/size/resizable=true
window/stretch/mode="2d"

[rendering]
quality/driver/driver_name="GLES3"
quality/shadows/enable=true
environment/default_clear_color=Color(0.008, 0.012, 0.018, 1)

[physics]
3d/default_gravity=24.0

[gui]
theme/default_font_multichannel_signed_distance_field=true
